{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["gru1"],
  "functions": {
    "api/alerts.js": { "maxDuration": 40 },
    "api/official.js": { "maxDuration": 30 },
    "api/model.js": { "maxDuration": 40 },
    "api/ensemble.js": { "maxDuration": 40 },
    "api/grid.js": { "maxDuration": 60 },
    "api/glm.py": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/assets/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/assets/municipios.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, stale-while-revalidate=86400" }]
    }
  ]
}
